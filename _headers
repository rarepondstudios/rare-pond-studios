# Baseline security headers for every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # HSTS: force HTTPS for this host for 6 months. Deliberately host-only (no
  # includeSubDomains / preload) so it can never affect other rarepond.com
  # subdomains (e.g. tooling) and is easy to roll back (set max-age=0).
  Strict-Transport-Security: max-age=15552000

# Always re-check content JSON so CMS edits show up immediately
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Media caches hard for a week (same rule as the jackcarlsen repo). Safe because the
# exporters append ?h=<content-hash> to changed files, so a replaced image always gets
# a fresh URL; unchanged files stay cached.
/media/*
  Cache-Control: public, max-age=604800

# The HTML entry points must always revalidate — heuristic browser caching served a STALE
# page shell after deploys (seen on /media: new features "missing" until a hard refresh).
# These come LAST so they override the /media/* cache rule for the /media page itself.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/media
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/media/
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/rentals
  Cache-Control: public, max-age=0, must-revalidate
/rentals/
  Cache-Control: public, max-age=0, must-revalidate
